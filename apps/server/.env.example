# App
NODE_ENV=development

# Server
PORT=5000

# CORS - comma-separated list of allowed browser origins
# (Electron dev server + file:// protocol are pre-allowed when origin is absent)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,file://,null

# Database (MongoDB Atlas)
# Replace with your own connection string - never commit real credentials
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/syami?retryWrites=true&w=majority
# Set to true to eagerly connect at boot (health check runs regardless)
DB_CONNECT_ON_START=false

# Ollama - required from Phase 5 (AI integration)
OLLAMA_BASE_URL=http://localhost:11434
# Model tag installed locally via: ollama pull qwen2.5:3b
# Swap the tag (e.g. qwen2.5) after pulling a different size
OLLAMA_MODEL=qwen2.5:3b
# Generation options - loaded centrally via src/config/ai.ts
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_CTX=4096
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_TIMEOUT_MS=60000
# Streaming responses (reserved for the streaming phase; keep false until then)
AI_STREAMING_ENABLED=false
